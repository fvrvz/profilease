# =============================================================================
# Profilease Root Environment Configuration Template
# =============================================================================
# Duplicate this file as .env before running local Docker Compose or dev servers:
#   cp .env.example .env
# =============================================================================

# --- Web & Angular SSR Service ---
PORT=4000
NODE_ENV=development
NOTIFICATION_SERVICE_URL=http://localhost:3333/api/notifications/dispatch

# --- Notifications Microservice ---
NOTIFICATION_PORT=3333

# --- NestJS Observe APM (https://observe.nestjs.com) ---
OBSERVE_APP_KEY=your_observe_app_key_here
OBSERVE_APP_SECRET=your_observe_app_secret_here

# --- Email Provider: Resend (https://resend.com) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Object Storage: Tigris S3-compatible (https://tigrisdata.com) ---
TIGRIS_ACCESS_KEY_ID=your_tigris_access_key_id_here
TIGRIS_SECRET_ACCESS_KEY=your_tigris_secret_access_key_here
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_BUCKET=profilease-media
TIGRIS_REGION=auto

# --- Cloudflare Edge & D1 Database ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=db09948bc7789d7b214dec80088b2391

# --- Infrastructure Connections (Docker Compose / Local) ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/profilease
POSTGRES_DB=profilease
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
