# =============================================================================
# Profilease Notifications Microservice - Environment Configuration Template
# =============================================================================
# Duplicate this file as .env and fill in the required credentials:
#   cp apps/notifications/.env.example apps/notifications/.env
# =============================================================================

# NestJS Observe (Official APM & Distributed Tracing - https://observe.nestjs.com)
# Generated automatically when running: npx @nestjs/observe link
OBSERVE_APP_KEY=your_observe_app_key_here
OBSERVE_APP_SECRET=your_observe_app_secret_here

# Resend Email Delivery (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Service Port
NOTIFICATION_PORT=3333
PORT=3333

# RabbitMQ Event Broker (AMQP)
# Example: amqp://guest:guest@localhost:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
