<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>New Appointment Request - Profilease</title>
  <style>
    * { box-sizing: border-box; border-radius: 0 !important; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace; background-color: #f8fafc; margin: 0; padding: 32px 16px; color: #0f172a; }
    .box { max-width: 620px; margin: 0 auto; background: #ffffff; border: 3px solid #0f172a; padding: 32px; box-shadow: 8px 8px 0px 0px rgba(0, 0, 0, 1); }
    .badge { display: inline-block; background: #0f172a; color: #ffffff; padding: 5px 12px; font-size: 11px; text-transform: uppercase; font-weight: 800; letter-spacing: 0.12em; margin-bottom: 20px; }
    h1 { font-size: 24px; color: #0f172a; margin: 0 0 16px 0; font-weight: 900; letter-spacing: -0.02em; text-transform: uppercase; }
    p { font-size: 14px; line-height: 1.6; color: #334155; margin: 0 0 20px 0; }
    .details-card { border: 2px solid #0f172a; padding: 20px; background: #f8fafc; margin: 24px 0; }
    .detail-row { display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 8px 0; font-size: 13px; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #64748b; font-weight: 700; text-transform: uppercase; font-size: 11px; }
    .detail-value { color: #0f172a; font-weight: 800; text-align: right; }
    .btn-group { display: flex; gap: 12px; margin-top: 28px; }
    .btn { display: inline-block; padding: 14px 24px; font-weight: 800; font-size: 13px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; text-align: center; border: 2px solid #0f172a; box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 1); }
    .btn-accept { background: #0d9488; color: #ffffff; border-color: #0d9488; }
    .btn-decline { background: #ef4444; color: #ffffff; border-color: #ef4444; }
    .footer { margin-top: 32px; font-size: 11px; color: #64748b; border-top: 2px solid #0f172a; padding-top: 16px; font-family: monospace; }
  </style>
</head>
<body>
  <div class="box">
    <div class="badge">Profilease Instant Booking Alert</div>
    <h1>New Booking: {{clientName}}</h1>
    <p>
      Hello <strong>{{professionalName}}</strong>, you have received a new consultation request. You can accept or decline this appointment instantly with a single click below:
    </p>

    <div class="details-card">
      <div class="detail-row">
        <span class="detail-label">Service</span>
        <span class="detail-value">{{serviceTitle}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Date & Time</span>
        <span class="detail-value">{{appointmentDate}} at {{appointmentTime}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Client / Patient</span>
        <span class="detail-value">{{clientName}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Client Email</span>
        <span class="detail-value">{{clientEmail}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Client Phone</span>
        <span class="detail-value">{{clientPhone}}</span>
      </div>
      {{#if notes}}
      <div class="detail-row">
        <span class="detail-label">Client Notes</span>
        <span class="detail-value">{{notes}}</span>
      </div>
      {{/if}}
    </div>

    <div class="btn-group">
      <a href="{{acceptUrl}}" class="btn btn-accept">Accept Appointment</a>
      <a href="{{declineUrl}}" class="btn btn-decline">Decline Request</a>
    </div>

    <div class="footer">
      <p>Secure Action Token: <code>{{actionToken}}</code></p>
      <p>Autonomous notification generated via Profilease Engine. No dashboard login required.</p>
    </div>
  </div>
</body>
</html>
