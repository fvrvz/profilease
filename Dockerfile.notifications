# syntax=docker/dockerfile:1.4
# Multi-stage production build for Profilease NestJS Notifications Microservice

# Stage 1: Dependencies cache
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit --legacy-peer-deps

# Stage 2: Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
RUN npx nx build notifications --configuration=production

# Stage 3: Isolated Production Dependencies for Notifications
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY --from=builder /app/dist/apps/notifications/package.json ./package.json
RUN npm install --omit=dev --no-audit --prefer-offline

# Stage 4: Lean Production Runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3333

# Create unprivileged application user
RUN addgroup -g 1001 -S profilease && \
    adduser -u 1001 -S profilease -G profilease

COPY --from=prod-deps --chown=profilease:profilease /app/node_modules ./node_modules
COPY --from=builder --chown=profilease:profilease /app/dist/apps/notifications ./dist
COPY --from=builder --chown=profilease:profilease /app/apps/notifications/src/assets ./dist/assets

USER profilease

EXPOSE 3333

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3333/api/health || exit 1

CMD ["node", "dist/main.js"]
