# syntax=docker/dockerfile:1.4
# Multi-stage production build for Profilease NestJS Notifications Microservice

# Stage 1: Dependencies cache
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit --legacy-peer-deps

# Stage 2: Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
RUN npx nx build notifications --configuration=production

# Stage 3: Runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3333

# Create unprivileged application user
RUN addgroup -g 1001 -S profilease && \
    adduser -u 1001 -S profilease -G profilease

COPY --from=builder /app/package*.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/dist/apps/notifications ./dist
COPY --from=builder /app/apps/notifications/src/assets ./dist/assets

USER profilease

EXPOSE 3333

CMD ["node", "dist/main.js"]
